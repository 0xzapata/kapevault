{
  "name": "kapevault",
  "productName": "KAPEVault",
  "private": true,
  "version": "0.1.4",
  "license": "GPL-3.0-only",
  "author": {
    "name": "BrewedOps",
    "url": "https://kapevault.brewedops.cloud"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "kapevault": "cli/kapevault.cjs"
  },
  "scripts": {
    "dev": "vite",
    "app:dev": "node scripts/dev.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "prebuild": "node scripts/check-node-pin.mjs",
    "build": "tsc && vite build",
    "postbuild": "node scripts/write-version.mjs && node scripts/third-party-notices.mjs",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.js.json",
    "test": "node --test \"electron/*.test.cjs\" \"core/**/*.test.js\" \"src/**/*.test.ts\" \"cli/*.test.cjs\"",
    "e2e": "npm run build && node scripts/e2e.cjs && node scripts/e2e-v2.cjs && node scripts/e2e-held-for.cjs && node scripts/e2e-recovery-codes.cjs && node scripts/e2e-lie-keeper.cjs && node scripts/e2e-shrink-queue.cjs && node scripts/e2e-where-is-it.cjs && node scripts/e2e-sticker-capture.cjs && node scripts/e2e-id.cjs && node scripts/e2e-air-wall.cjs && node scripts/e2e-opener.cjs && node scripts/e2e-carryover.cjs && node scripts/e2e-sync.cjs",
    "design": "npm run build && node scripts/design-shots.cjs",
    "logos:check": "node scripts/logo-sheet.cjs",
    "icon": "node scripts/make-icon.cjs",
    "shortcut": "node scripts/install-shortcut.mjs",
    "installer": "npm run build && electron-builder --win && node scripts/check-fuses.mjs && node scripts/packaged-smoke.mjs && node scripts/checksums.mjs",
    "installer:mac": "npm run build && electron-builder --mac --config.directories.output=dist-installer",
    "reinstall": "node scripts/reinstall.mjs",
    "import:check": "node scripts/import-dryrun.cjs",
    "kit:fit": "node scripts/kit-fit.cjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "jsqr": "^1.4.0",
    "marked": "^18.0.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.brewedops.kapevault",
    "productName": "KAPEVault",
    "copyright": "Copyright © 2026 BrewedOps",
    "directories": {
      "output": "${env.LOCALAPPDATA}/KAPEVault-build"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "!electron/*.test.cjs",
      "!electron/fixtures/**/*",
      "core/**/*",
      "!core/**/*.test.js",
      "!core/sync/test-helpers.js",
      "!core/**/fixtures/**",
      "dist/**/*",
      "!dist/legal/**/*",
      "build/icon.ico",
      "build/tray.png",
      "build/tray@2x.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "!node_modules/**/*",
      "node_modules/jsqr/**/*"
    ],
    "extraResources": [
      { "from": "LICENSE", "to": "legal/LICENSE" },
      { "from": "LICENSE-EXCEPTION", "to": "legal/LICENSE-EXCEPTION" },
      { "from": "NOTICE", "to": "legal/NOTICE" },
      { "from": "dist/legal/THIRD-PARTY-NOTICES.txt", "to": "legal/THIRD-PARTY-NOTICES.txt" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "KAPEVault shows the folders you saved as file links.",
        "NSDocumentsFolderUsageDescription": "KAPEVault shows the folders you saved as file links.",
        "NSDownloadsFolderUsageDescription": "KAPEVault shows the folders you saved as file links."
      }
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
