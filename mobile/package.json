{
  "name": "kapevault-mobile",
  "private": true,
  "version": "0.1.7",
  "license": "GPL-3.0-only",
  "scripts": {
    "sim": "node scripts/sim.mjs",
    "sim:live": "node scripts/sim.mjs --live",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "sync": "vite build && cap sync android",
    "apk": "vite build --mode debug && cap sync android && node scripts/gradle.mjs assembleDebug",
    "apk:release": "npm run build && cap sync android && node scripts/apk-release.mjs",
    "apk:release:foss": "npm run build && cap sync android && node scripts/apk-release.mjs --foss",
    "aab:release": "npm run build && cap sync android && node scripts/apk-release.mjs --bundle",
    "notices:android": "node scripts/android-notices.mjs --check",
    "proof": "node scripts/proof.mjs",
    "test": "node --import ./src/app/host/test/register.mjs --test \"src/app/host/**/*.test.mjs\" \"src/app/hooks/**/*.test.mjs\" \"src/app/lib/**/*.test.mjs\" \"src/app/components/**/*.test.mjs\" \"src/app/features/**/*.test.mjs\" \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
